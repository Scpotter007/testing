DATABASE_URL=postgres://user:password@localhost:5432/dating_app
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Chat encryption (required in production — use a strong random string or KMS key reference)
CHAT_ENCRYPTION_SECRET=change-me-to-a-strong-random-secret

# Token defaults
SIGNUP_BONUS_TOKENS=50
MEETING_REWARD_TOKENS=50
MIN_REQUEST_TOKENS=10
REQUEST_EXPIRY_HOURS=24

# Distance limits (meters)
DISCOVERY_RADIUS_METERS=20000
MEETING_PROXIMITY_METERS=20

# QR token TTL
QR_TOKEN_TTL_SECONDS=300

# Request gender pairing: 'male_to_female' (default, per MVP spec) or 'open' (any-to-any)
REQUEST_GENDER_PAIRING=male_to_female

# Payment gateway (pluggable: mock | stripe | ...)
PAYMENT_PROVIDER=mock

# Server
PORT=3000
NODE_ENV=development
